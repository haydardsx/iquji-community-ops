{
  "version": 3,
  "limits": {
    "maxClientNameBytes": 100,
    "maxTargetsPerCommand": 100,
    "maxPreapprovals": 100,
    "maxTargetBytes": 160,
    "maxHintCharacters": 500,
    "maxArgumentBytes": 16384
  },
  "pages": {
    "home": {
      "path": "/",
      "tabs": [
        "projects",
        "servers",
        "swarm"
      ]
    },
    "projects": {
      "path": "/projects",
      "tabs": [
        "applications",
        "source",
        "runtime",
        "container",
        "routes",
        "variables",
        "logs"
      ]
    },
    "servers": {
      "path": "/servers",
      "tabs": [
        "overview",
        "runtime"
      ]
    },
    "settings": {
      "path": "/settings",
      "tabs": [
        "appearance",
        "general",
        "secrets",
        "application-templates",
        "domain-certificates",
        "network",
        "backup",
        "automation"
      ]
    },
    "tunnels": {
      "path": "/tunnels",
      "tabs": [
        "overview",
        "probe",
        "history",
        "config"
      ]
    }
  },
  "commands": [
    {
      "name": "command_catalog",
      "description": "读取带版本的命令、页面与页签目录",
      "fields": [],
      "required": [],
      "confirm": false,
      "group": "data"
    },
    {
      "name": "monitoring_summary",
      "description": "读取监控首页摘要",
      "fields": [],
      "required": [],
      "confirm": false,
      "group": "data"
    },
    {
      "name": "projects_list",
      "description": "列出项目及应用",
      "fields": [],
      "required": [],
      "confirm": false,
      "group": "data"
    },
    {
      "name": "servers_list",
      "description": "列出受管服务器",
      "fields": [],
      "required": [],
      "confirm": false,
      "group": "data"
    },
    {
      "name": "tunnels_list",
      "description": "列出内网穿透实例",
      "fields": [],
      "required": [],
      "confirm": false,
      "group": "data"
    },
    {
      "name": "templates_list",
      "description": "列出应用模板",
      "fields": [],
      "required": [],
      "confirm": false,
      "group": "data"
    },
    {
      "name": "application_runtime",
      "description": "查看应用运行服务与副本",
      "fields": [
        "target"
      ],
      "required": [
        "target"
      ],
      "confirm": false,
      "group": "data"
    },
    {
      "name": "container_logs",
      "description": "读取服务的容器标准输出与错误输出",
      "fields": [
        "target",
        "slot"
      ],
      "required": [
        "target",
        "slot"
      ],
      "confirm": false,
      "group": "logs"
    },
    {
      "name": "application_log_configure",
      "description": "设置应用日志查询命令，argv 为 JSON 字符串数组，空数组清除命令",
      "fields": [
        "target",
        "argv"
      ],
      "required": [
        "target",
        "argv"
      ],
      "confirm": true,
      "group": "logs",
      "guide": true
    },
    {
      "name": "application_logs",
      "description": "在指定副本执行已配置的日志查询命令",
      "fields": [
        "target",
        "slot",
        "task"
      ],
      "required": [
        "target",
        "slot"
      ],
      "confirm": true,
      "group": "logs",
      "guide": true
    },
    {
      "name": "application_release",
      "description": "构建并发布应用，requestKey 用于重试",
      "fields": [
        "target",
        "requestKey"
      ],
      "required": [
        "target",
        "requestKey"
      ],
      "confirm": true,
      "group": "operations",
      "guide": true
    },
    {
      "name": "application_restart",
      "description": "重启应用，requestKey 用于重试",
      "fields": [
        "target",
        "requestKey"
      ],
      "required": [
        "target",
        "requestKey"
      ],
      "confirm": true,
      "group": "operations",
      "guide": true
    },
    {
      "name": "operation_get",
      "description": "按 ID 查询操作状态",
      "fields": [
        "target"
      ],
      "required": [
        "target"
      ],
      "confirm": false,
      "group": "operations"
    },
    {
      "name": "tutorial_list",
      "description": "列出教程、步骤和可定位的页面控件，target 可限定教程 ID",
      "fields": [
        "target"
      ],
      "required": [],
      "confirm": false,
      "group": "tutorial"
    },
    {
      "name": "tutorial_state",
      "description": "读取本客户端的活动教程、步骤和进度，target 可限定教程 ID",
      "fields": [
        "target"
      ],
      "required": [],
      "confirm": false,
      "group": "tutorial"
    },
    {
      "name": "tutorial_start",
      "description": "启动已登记教程，target 为教程 ID，step 可选",
      "fields": [
        "target",
        "step"
      ],
      "required": [
        "target"
      ],
      "confirm": false,
      "group": "tutorial"
    },
    {
      "name": "tutorial_goto",
      "description": "定位教程内的指定步骤并显示指引",
      "fields": [
        "target",
        "step"
      ],
      "required": [
        "target",
        "step"
      ],
      "confirm": false,
      "group": "tutorial"
    },
    {
      "name": "tutorial_next",
      "description": "显示指定教程的下一步",
      "fields": [
        "target"
      ],
      "required": [
        "target"
      ],
      "confirm": false,
      "group": "tutorial"
    },
    {
      "name": "tutorial_previous",
      "description": "返回指定教程的上一步",
      "fields": [
        "target"
      ],
      "required": [
        "target"
      ],
      "confirm": false,
      "group": "tutorial"
    },
    {
      "name": "tutorial_close",
      "description": "关闭由本客户端开启的指定教程",
      "fields": [
        "target"
      ],
      "required": [
        "target"
      ],
      "confirm": false,
      "group": "tutorial"
    },
    {
      "name": "tutorial_hint",
      "description": "在已登记的教程步骤显示由客户端署名的纯文本提示，最长 500 个字符",
      "fields": [
        "target",
        "step",
        "message"
      ],
      "required": [
        "target",
        "step",
        "message"
      ],
      "confirm": false,
      "group": "tutorial"
    },
    {
      "name": "page_state",
      "description": "读取当前窗口的页面、选中对象和可用控件",
      "fields": [],
      "required": [],
      "confirm": false,
      "group": "window"
    },
    {
      "name": "page_control",
      "description": "操作当前页面已登记的显示偏好、筛选或刷新，target 与 field 取自 page_state 的 scopes 与 controls",
      "fields": [
        "target",
        "field",
        "value"
      ],
      "required": [
        "target",
        "field"
      ],
      "confirm": false,
      "group": "window",
      "guide": true
    },
    {
      "name": "page_open",
      "description": "定位页面和对象，page 取 home、projects、servers、tunnels、settings",
      "fields": [
        "page",
        "target",
        "application",
        "tab"
      ],
      "required": [
        "page"
      ],
      "confirm": false,
      "group": "window",
      "guide": true
    },
    {
      "name": "form_open",
      "description": "打开当前页面上指定的表单",
      "fields": [
        "target"
      ],
      "required": [
        "target"
      ],
      "confirm": false,
      "group": "window",
      "guide": true
    },
    {
      "name": "form_close",
      "description": "关闭本客户端打开的表单并放弃草稿",
      "fields": [
        "target"
      ],
      "required": [
        "target"
      ],
      "confirm": false,
      "group": "window",
      "guide": true
    },
    {
      "name": "form_fill",
      "description": "填写已登记字段，target 使用 form_open 返回的 forms[].target",
      "fields": [
        "target",
        "field",
        "value"
      ],
      "required": [
        "target",
        "field"
      ],
      "confirm": false,
      "group": "window",
      "guide": true
    },
    {
      "name": "form_submit",
      "description": "保存当前表单，target 使用 forms[].target（含对象 ID），requestKey 用于重试",
      "fields": [
        "target",
        "requestKey"
      ],
      "required": [
        "target",
        "requestKey"
      ],
      "confirm": true,
      "group": "window",
      "guide": true
    },
    {
      "name": "action_guide",
      "description": "在目标操作的界面控件旁引导用户。根据原动作及其目标授权定位，用户亲自决定是否执行。",
      "fields": [
        "action",
        "target",
        "page",
        "tab",
        "application",
        "field",
        "slot",
        "task"
      ],
      "required": [
        "action"
      ],
      "confirm": false,
      "group": "window"
    }
  ]
}
